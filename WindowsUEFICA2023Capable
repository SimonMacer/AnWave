$command = 'reg add "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Secureboot\Servicing" /v "WindowsUEFICA2023Capable" /t REG_DWORD /d 1 /f'
Start-Process -FilePath "cmd.exe" -ArgumentList "/c $command" -NoNewWindow -Wait
$command = 'mountvol X: /d'
Start-Process -FilePath "cmd.exe" -ArgumentList "/c $command" -NoNewWindow -Wait
CLS
Write-Host "Restore Windows Boot Manager successful!" -ForegroundColor Green
Write-Output 'Please restart the system!'
$RebootASK = Read-Host "Would you like to restart the system? (Y = Yes)" -WarningAction Inquire
if ( $RebootASK -eq 'y' )
{
Restart-Computer -Force
}
}
if ( $AskCA2 -eq 'n') {
Exit
} else {
Exit
}
} else {
CLS
Write-Host "Windows UEFI CA 2023 not in DB." -ForegroundColor Red
Pause
Exit
}
